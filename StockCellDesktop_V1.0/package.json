{
  "name": "stock-cell-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "A股资金细胞可视化透明桌面版 - 兼容 StockTray/EdgeBridge 接口",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "verify": "node bridge_smoke_test.js",
    "pack:win": "electron-builder --win portable",
    "build:local": "npm run verify && electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.stockcell.desktop",
    "productName": "A股资金细胞透明桌面版",
    "artifactName": "A股资金细胞透明桌面版_V${version}.${ext}",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "edge_bridge_server.js",
      "stock_cell_desktop.html"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "engines": {
    "node": ">=22 <23"
  }
}